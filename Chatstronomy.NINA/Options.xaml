<ResourceDictionary
    x:Class="Chatstronomy.NINA.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Chatstronomy.NINA.UI">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="Chatstronomy_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" Margin="0,0,12,16">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Chat delivery" />
                <TextBlock
                    Margin="0,4,0,14"
                    Text="Connect this N.I.N.A. profile to the hosted Chatstronomy Hub, or run Discord or Matrix delivery locally."
                    TextWrapping="Wrap" />

                <Border Padding="12" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Chatstronomy Hub — hosted service"
                            IsChecked="{Binding UseHostedService}" />
                        <TextBlock
                            Margin="22,2,0,10"
                            Text="Connect outbound to hub.chatstronomy.com; no Discord credential or local bot is needed."
                            TextWrapping="Wrap" />

                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Discord webhook — simple local notifications"
                            IsChecked="{Binding UseDiscordWebhook}" />
                        <TextBlock
                            Margin="22,2,0,10"
                            Text="Run Chatstronomy on this computer and post through an existing Discord webhook."
                            TextWrapping="Wrap" />

                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Discord app / bot — full local bot"
                            IsChecked="{Binding UseDiscordBot}" />
                        <TextBlock
                            Margin="22,2,0,10"
                            Text="Run Chatstronomy in the background with your Discord application credentials and slash commands."
                            TextWrapping="Wrap" />

                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Matrix only — local Matrix account"
                            IsChecked="{Binding UseMatrixOnly}" />
                        <TextBlock
                            Margin="22,2,0,0"
                            Text="Run Chatstronomy on this computer using Matrix without requiring Discord."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Security and privacy" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="These safeguards are enforced inside this N.I.N.A. profile for both the hosted Hub and local chat bots. Hardware control, every individual command, sequence-validation bypass, and location sharing all default to off."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Allow remote telescope and camera control"
                                TextWrapping="Wrap" />
                            <CheckBox
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                IsChecked="{Binding AllowRemoteControl}" />
                        </Grid>
                        <TextBlock
                            Margin="0,0,30,10"
                            Text="The master switch alone grants no command access. Also enable each exact operation you trust below. Turning off the master switch immediately returns this profile to read-only monitoring while preserving your individual selections."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="SemiBold"
                            Text="Individually permitted hardware commands" />
                        <UniformGrid
                            Margin="0,0,0,12"
                            Columns="2"
                            IsEnabled="{Binding AllowRemoteControl}">
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Unpark mount (/unpark)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowUnparkMount}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Home mount (/home)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowHomeMount}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Park mount (/park)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowParkMount}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Change filter (/change-filter)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowChangeFilter}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Start guiding (/guider-start)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowStartGuiding}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Stop guiding (/guider-stop)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowStopGuiding}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Cool camera (/cool)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowCoolCamera}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Warm camera (/warm)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowWarmCamera}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Start autofocus (/autofocus)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowStartAutofocus}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Cancel autofocus (/autofocus)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowCancelAutofocus}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Abort exposure (/abort-capture)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowAbortExposure}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Stop sequence (/stop-sequence)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowStopSequence}" />
                            </Grid>
                            <Grid Margin="0,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Start sequence (/start-sequence)" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding AllowStartSequence}" />
                            </Grid>
                            <Grid
                                Margin="0,3,16,3"
                                IsEnabled="{Binding AllowStartSequence}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Allow skipping sequence safety checks"
                                    TextWrapping="Wrap" />
                                <CheckBox
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    IsChecked="{Binding AllowSkipSequenceValidation}" />
                            </Grid>
                        </UniformGrid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Share exact observatory coordinates and location-derived mount position"
                                TextWrapping="Wrap" />
                            <CheckBox
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                IsChecked="{Binding ShareObservatoryLocation}" />
                        </Grid>
                        <TextBlock
                            Margin="0,0,30,0"
                            Text="When disabled, latitude, longitude, elevation, local sidereal time, altitude, azimuth, and derived meridian timing are redacted before any data leaves N.I.N.A. Hardware device IDs and sequence script or file paths are always redacted."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid
                    Margin="0,14,0,0"
                    Visibility="{Binding UseDiscordWebhook, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Discord webhook URL" />
                    <PasswordBox
                        Grid.Column="1"
                        MinWidth="420"
                        ui:PasswordBoxBinding.Attach="True"
                        ui:PasswordBoxBinding.Password="{Binding DiscordWebhookUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <Grid
                    Margin="0,14,0,0"
                    Visibility="{Binding UseDiscordBot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" Text="Discord bot token" />
                    <PasswordBox
                        Grid.Column="1"
                        Margin="0,4"
                        ui:PasswordBoxBinding.Attach="True"
                        ui:PasswordBoxBinding.Password="{Binding DiscordBotToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="Application ID (optional)" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding DiscordApplicationId, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Center" Text="Default channel ID" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding DiscordChannelId, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <Grid
                    Margin="0,14,0,0"
                    Visibility="{Binding UseHostedService, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" Text="HTTPS / WSS hub URL" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding HostedServiceUrl, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="One-time pairing code" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4">
                        <PasswordBox
                            ui:PasswordBoxBinding.Attach="True"
                            ui:PasswordBoxBinding.Password="{Binding HostedPairingToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Margin="0,6,0,2" TextWrapping="Wrap">
                            <Run Text="Need a code? " />
                            <Hyperlink
                                NavigateUri="https://hub.chatstronomy.com/"
                                RequestNavigate="Hyperlink_RequestNavigate">Open Chatstronomy Hub</Hyperlink>
                            <Run Text=", add or select your telescope, and choose Connect rig…" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,2" TextWrapping="Wrap">
                            <Run Text="Before pairing, review the " />
                            <Hyperlink
                                NavigateUri="https://chatstronomy.com/hub-privacy.html"
                                RequestNavigate="Hyperlink_RequestNavigate">hosted privacy policy</Hyperlink>
                            <Run Text=" and " />
                            <Hyperlink
                                NavigateUri="https://chatstronomy.com/hub-terms.html"
                                RequestNavigate="Hyperlink_RequestNavigate">hosted service terms</Hyperlink>
                            <Run Text="." />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Top" Text="Connection credential" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding HostedCredentialStatus}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Command="{Binding ConnectHostedCommand}"
                            Content="Pair / reconnect" />
                        <Button
                            MinWidth="90"
                            Margin="0,0,8,0"
                            Command="{Binding DisconnectHostedCommand}"
                            Content="Disconnect" />
                        <Button
                            MinWidth="110"
                            Command="{Binding ForgetHostedCredentialCommand}"
                            Content="Forget credential" />
                    </StackPanel>
                </Grid>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding UsesLocalRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Matrix delivery" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="Use Matrix by itself, or connect it alongside the selected local Discord delivery."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Enable Matrix alongside Discord" />
                            <CheckBox
                                Grid.Column="1"
                                IsEnabled="{Binding CanToggleLocalMatrix}"
                                IsChecked="{Binding UseLocalMatrix}" />
                        </Grid>
                        <Grid Visibility="{Binding UseLocalMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" Text="HTTPS homeserver URL" />
                            <TextBox
                                Grid.Column="1"
                                Margin="0,4"
                                Text="{Binding MatrixHomeserverUrl, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="Username" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4"
                                Text="{Binding MatrixUsername, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Center" Text="Password" />
                            <PasswordBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,4"
                                ui:PasswordBoxBinding.Attach="True"
                                ui:PasswordBoxBinding.Password="{Binding MatrixPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Margin="0,4,12,4" VerticalAlignment="Center" Text="Default room ID" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,4"
                                Text="{Binding MatrixRoomId, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Event delivery" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="Choose which N.I.N.A. events become chat messages. Disabling a chat notification does not prevent that event from being transmitted to the Hub or local bot for status and target tracking."
                            TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Images and thumbnails" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendImageEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Autofocus results" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendAutofocusEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Guiding and dithering" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendGuidingEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Mount, slew, and center" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendMountEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Sequence, waits, and cooling" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendSequenceEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Targets and Target Scheduler" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendTargetSchedulerEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Filter, focuser, and rotator" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendFilterFocuserRotatorEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Equipment connections" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendEquipmentConnectionEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Other N.I.N.A. events" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendOtherEvents}" />
                            </Grid>
                            <Grid Margin="0,3,18,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Popup notifications" />
                                <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding SendNinaNotifications}" />
                            </Grid>
                        </UniformGrid>

                        <TextBlock Margin="0,14,0,3" FontWeight="SemiBold" Text="N.I.N.A. log lines" />
                        <TextBlock
                            Margin="0,0,0,7"
                            Text="Log forwarding is opt-in because logs can be frequent and may contain equipment paths or other private details. Chatstronomy captures every level N.I.N.A. writes; select the levels to send."
                            TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Margin="0,3,18,3" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Errors" />
                                <CheckBox Margin="8,0,0,0" IsChecked="{Binding SendNinaLogErrors}" />
                            </StackPanel>
                            <StackPanel Margin="0,3,18,3" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Warnings" />
                                <CheckBox Margin="8,0,0,0" IsChecked="{Binding SendNinaLogWarnings}" />
                            </StackPanel>
                            <StackPanel Margin="0,3,18,3" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Information" />
                                <CheckBox Margin="8,0,0,0" IsChecked="{Binding SendNinaLogInformation}" />
                            </StackPanel>
                            <StackPanel Margin="0,3,18,3" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Debug" />
                                <CheckBox Margin="8,0,0,0" IsChecked="{Binding SendNinaLogDebug}" />
                            </StackPanel>
                            <StackPanel Margin="0,3,0,3" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Trace" />
                                <CheckBox Margin="8,0,0,0" IsChecked="{Binding SendNinaLogTrace}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding UsesLocalRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Local Chatstronomy runtime" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="The plugin starts its bundled Chatstronomy runtime and supplies native N.I.N.A. data plus credentials over current-user-only named pipes. It does not open an observatory HTTP endpoint."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Runtime executable" />
                            <TextBox
                                Grid.Column="1"
                                Text="{Binding LocalRuntimePath, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <StackPanel
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="110"
                                Margin="0,0,8,0"
                                Command="{Binding StartRuntimeCommand}"
                                Content="Start / restart" />
                            <Button
                                MinWidth="80"
                                Command="{Binding StopRuntimeCommand}"
                                Content="Stop" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,14,0,0"
                    Padding="10"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                    <TextBlock Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
