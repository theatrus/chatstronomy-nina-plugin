<ResourceDictionary
    x:Class="Chatstronomy.NINA.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Chatstronomy.NINA.UI">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="Chatstronomy_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" Margin="0,0,12,16">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Chat delivery" />
                <TextBlock
                    Margin="0,4,0,14"
                    Text="Choose local Discord or Matrix delivery, or connect this N.I.N.A. profile to the hosted Chatstronomy Hub."
                    TextWrapping="Wrap" />

                <Border Padding="12" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Discord webhook — simple local notifications"
                            IsChecked="{Binding UseDiscordWebhook}" />
                        <TextBlock
                            Margin="22,2,0,10"
                            Text="Run Chatstronomy on this computer and post through an existing Discord webhook."
                            TextWrapping="Wrap" />

                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Discord app / bot — full local bot"
                            IsChecked="{Binding UseDiscordBot}" />
                        <TextBlock
                            Margin="22,2,0,10"
                            Text="Run Chatstronomy in the background with your Discord application credentials and slash commands."
                            TextWrapping="Wrap" />

                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Matrix only — local Matrix account"
                            IsChecked="{Binding UseMatrixOnly}" />
                        <TextBlock
                            Margin="22,2,0,10"
                            Text="Run Chatstronomy on this computer using Matrix without requiring Discord."
                            TextWrapping="Wrap" />

                        <RadioButton
                            GroupName="ChatstronomyDelivery"
                            Content="Chatstronomy.com — hosted bot"
                            IsChecked="{Binding UseHostedService}" />
                        <TextBlock
                            Margin="22,2,0,0"
                            Text="Connect this N.I.N.A. profile outbound to the hosted service; no Discord credential or local bot is needed."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid
                    Margin="0,14,0,0"
                    Visibility="{Binding UseDiscordWebhook, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Discord webhook URL" />
                    <PasswordBox
                        Grid.Column="1"
                        MinWidth="420"
                        ui:PasswordBoxBinding.Attach="True"
                        ui:PasswordBoxBinding.Password="{Binding DiscordWebhookUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <Grid
                    Margin="0,14,0,0"
                    Visibility="{Binding UseDiscordBot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" Text="Discord bot token" />
                    <PasswordBox
                        Grid.Column="1"
                        Margin="0,4"
                        ui:PasswordBoxBinding.Attach="True"
                        ui:PasswordBoxBinding.Password="{Binding DiscordBotToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="Application ID (optional)" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding DiscordApplicationId, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Center" Text="Default channel ID" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding DiscordChannelId, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <Grid
                    Margin="0,14,0,0"
                    Visibility="{Binding UseHostedService, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" Text="HTTPS / WSS hub URL" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding HostedServiceUrl, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="One-time pairing code" />
                    <PasswordBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        ui:PasswordBoxBinding.Attach="True"
                        ui:PasswordBoxBinding.Password="{Binding HostedPairingToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Top" Text="Connection credential" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding HostedCredentialStatus}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Command="{Binding ConnectHostedCommand}"
                            Content="Pair / reconnect" />
                        <Button
                            MinWidth="90"
                            Margin="0,0,8,0"
                            Command="{Binding DisconnectHostedCommand}"
                            Content="Disconnect" />
                        <Button
                            MinWidth="110"
                            Command="{Binding ForgetHostedCredentialCommand}"
                            Content="Forget credential" />
                    </StackPanel>
                </Grid>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding UsesLocalRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Matrix delivery" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="Use Matrix by itself, or connect it alongside the selected local Discord delivery."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Enable Matrix alongside Discord" />
                            <CheckBox
                                Grid.Column="1"
                                IsEnabled="{Binding CanToggleLocalMatrix}"
                                IsChecked="{Binding UseLocalMatrix}" />
                        </Grid>
                        <Grid Visibility="{Binding UseLocalMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,4,12,4" VerticalAlignment="Center" Text="HTTPS homeserver URL" />
                            <TextBox
                                Grid.Column="1"
                                Margin="0,4"
                                Text="{Binding MatrixHomeserverUrl, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="Username" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4"
                                Text="{Binding MatrixUsername, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Center" Text="Password" />
                            <PasswordBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,4"
                                ui:PasswordBoxBinding.Attach="True"
                                ui:PasswordBoxBinding.Password="{Binding MatrixPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Margin="0,4,12,4" VerticalAlignment="Center" Text="Default room ID" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,4"
                                Text="{Binding MatrixRoomId, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Event delivery" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="Choose which N.I.N.A. events become chat messages. Disabled events are still retained for status and target tracking."
                            TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                            <CheckBox Margin="0,3" Content="Images and thumbnails" IsChecked="{Binding SendImageEvents}" />
                            <CheckBox Margin="0,3" Content="Autofocus results" IsChecked="{Binding SendAutofocusEvents}" />
                            <CheckBox Margin="0,3" Content="Guiding and dithering" IsChecked="{Binding SendGuidingEvents}" />
                            <CheckBox Margin="0,3" Content="Mount, slew, and center" IsChecked="{Binding SendMountEvents}" />
                            <CheckBox Margin="0,3" Content="Sequence, waits, and cooling" IsChecked="{Binding SendSequenceEvents}" />
                            <CheckBox Margin="0,3" Content="Targets and Target Scheduler" IsChecked="{Binding SendTargetSchedulerEvents}" />
                            <CheckBox Margin="0,3" Content="Filter, focuser, and rotator" IsChecked="{Binding SendFilterFocuserRotatorEvents}" />
                            <CheckBox Margin="0,3" Content="Equipment connections" IsChecked="{Binding SendEquipmentConnectionEvents}" />
                            <CheckBox Margin="0,3" Content="Other N.I.N.A. events" IsChecked="{Binding SendOtherEvents}" />
                            <CheckBox Margin="0,3" Content="Popup notifications" IsChecked="{Binding SendNinaNotifications}" />
                        </UniformGrid>

                        <TextBlock Margin="0,14,0,3" FontWeight="SemiBold" Text="N.I.N.A. log lines" />
                        <TextBlock
                            Margin="0,0,0,7"
                            Text="Log forwarding is opt-in because logs can be frequent and may contain equipment paths or other private details. Chatstronomy captures every level N.I.N.A. writes; select the levels to send."
                            TextWrapping="Wrap" />
                        <WrapPanel>
                            <CheckBox Margin="0,3,18,3" Content="Errors" IsChecked="{Binding SendNinaLogErrors}" />
                            <CheckBox Margin="0,3,18,3" Content="Warnings" IsChecked="{Binding SendNinaLogWarnings}" />
                            <CheckBox Margin="0,3,18,3" Content="Information" IsChecked="{Binding SendNinaLogInformation}" />
                            <CheckBox Margin="0,3,18,3" Content="Debug" IsChecked="{Binding SendNinaLogDebug}" />
                            <CheckBox Margin="0,3" Content="Trace" IsChecked="{Binding SendNinaLogTrace}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding UsesLocalRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Local Chatstronomy runtime" />
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="The plugin starts its bundled Chatstronomy runtime and supplies native N.I.N.A. data plus credentials over current-user-only named pipes. It does not open an observatory HTTP endpoint."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Runtime executable" />
                            <TextBox
                                Grid.Column="1"
                                Text="{Binding LocalRuntimePath, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <StackPanel
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="110"
                                Margin="0,0,8,0"
                                Command="{Binding StartRuntimeCommand}"
                                Content="Start / restart" />
                            <Button
                                MinWidth="80"
                                Command="{Binding StopRuntimeCommand}"
                                Content="Stop" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,14,0,0"
                    Padding="10"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                    <TextBlock Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
